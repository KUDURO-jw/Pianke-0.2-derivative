<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ 的数据提取规则。

  片刻的片库、观影记录全部存放在应用私有目录的 SQLite 数据库中，
  属于用户隐私数据。这里显式禁止云备份与设备迁移，
  保证「数据只留在你自己的设备上」这一承诺成立。

  用户如需迁移，请使用应用内的「导出备份」或「坚果云同步」。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
